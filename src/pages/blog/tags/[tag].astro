---
import { type CollectionEntry } from 'astro:content';
import { getPublishedPosts } from '../../../lib/blog';
import TagPage from '../../../layouts/TagPage.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import PostTags from '../../../components/PostTags.astro';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) },
  }));
}
interface Props { tag: string; posts: CollectionEntry<'blog'>[] }
const { tag, posts } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---
<TagPage title={`#${tag}`} description={`${posts.length} ${posts.length === 1 ? 'article' : 'articles'} tagged with ${tag}.`}>
  <a href={`${base}blog/tags/`}>← All tags</a>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <article>
          <FormattedDate date={post.data.pubDate} />
          <h2><a href={`${base}blog/${post.id}/`}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
          <PostTags tags={post.data.tags} />
        </article>
      </li>
    ))}
  </ul>
</TagPage>
<style>
  .posts { list-style: none; padding: 0; margin-top: 2rem; }
  li { padding: 1.5rem 0; border-bottom: 1px solid var(--border-color); }
  h2 { font-size: 1.5rem; margin: 0.5rem 0; }
  h2 a { color: var(--text-primary); text-decoration: none; }
  h2 a:hover { color: var(--accent-color); }
  article :global(time), p { color: var(--text-muted); }
</style>
