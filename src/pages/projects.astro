---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;

const projects = [
  {
    title: 'FabFlow',
    description:
      'A discrete-event semiconductor fab simulator exploring scheduling, throughput, and bottleneck optimization.',
    stack: ['Python', 'SimPy', 'FastAPI', 'Docker'],
    url: 'https://github.com/j22868706/sideproject_fabflow',
  },
  {
    title: 'AI Chart Assistant',
    description:
      'An AI-powered clinical documentation assistant using speech recognition, RAG, and automated SOAP note generation.',
    stack: ['Python', 'Whisper', 'FastAPI', 'RAG'],
    url: 'https://github.com/j22868706/ai_chart_assistant',
  },
  {
    title: 'SisFall Detection',
    description:
      'A fall detection pipeline using wearable sensor data, machine learning, and real-time alert integration.',
    stack: ['LightGBM', 'FastAPI', 'Docker'],
    url: 'https://github.com/j22868706',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Projects | ${SITE_TITLE}`}
      description="Engineering projects exploring AI, software, and systems."
    />
  </head>
  <body>
    <Header />

    <main>
      <h1>Projects</h1>
      <p>Experiments and applications built while exploring AI, software, and systems.</p>

      <div class="project-list">
        {projects.map((project) => (
          <article class="project-card">
            <h2>{project.title}</h2>
            <p>{project.description}</p>
            <ul aria-label="Technologies">
              {project.stack.map((tech) => <li>{tech}</li>)}
            </ul>
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub ↗
            </a>
          </article>
        ))}
      </div>

      <p><a href={base}>← Back to Home</a></p>
    </main>

    <Footer />
  </body>
</html>

<style>
  .project-list {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .project-card {
    background: var(--surface);
    padding: 1.5rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 12px;
  }

  .project-card h2 {
    font-size: 1.5rem;
  }

  .project-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .project-card li {
    padding: 0.25rem 0.65rem;
    background: rgb(var(--gray-light));
    border-radius: 6px;
    font-size: 0.85rem;
  }
</style>
